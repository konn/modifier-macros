cabal-version: 3.4
name: modifier-generics
version: 0.1.0.0
synopsis: Generic representations with heterogeneous modifier metadata
description:
  Capture heterogeneous GHC modifier metadata on datatype declarations,
  constructors and fields for generic programming and Template Haskell.
  This experimental package targets a pinned GHC 10 prerelease. See README.md.

category: Generics
license: BSD-3-Clause
license-file: LICENSE
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
build-type: Simple
tested-with: ghc ==10.0.0.20260917
homepage: https://github.com/konn/modifier-macros
bug-reports: https://github.com/konn/modifier-macros/issues
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/modifier-macros.git
  subdir: modifier-generics

common defaults
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -Wmissing-export-lists
    -Wmissing-home-modules

  build-depends: base >=4.23 && <4.24

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    Generics.Modifier
    Generics.Modifier.Plugin

  build-depends:
    ghc ==10.0.0.20260917,
    modifier-common >=0.1 && <0.2,

test-suite modifier-generics-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  -- cabal-gild: discover test --exclude=test/Main.hs
  other-modules:
    BothPlugins
    Fixture
    Generics.Modifier.Deriving.MissingStock
    Generics.Modifier.DerivingFixtures
    Generics.Modifier.DerivingSpec
    Generics.Modifier.InspectionSpec
    Generics.Modifier.PropertySpec
    Generics.ModifierSpec

  build-depends:
    falsify >=0.4 && <0.5,
    modifier-generics,
    tasty,
    tasty-falsify,
    tasty-hunit,
    tasty-inspection-testing,
    template-haskell >=2.25 && <2.26,
    th-reify-modifier,

  build-tool-depends: tasty-discover:tasty-discover
